<%- include('../partials/header') %>

<h1 class="h3 mb-2">Comments on my ads</h1>
<p class="text-muted mb-4">Here you can remove inappropriate comments written under your ads.</p>

<% if (comments.length === 0) { %>
  <div class="alert alert-secondary">There are no comments under your ads yet.</div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Ad</th>
            <th>Author</th>
            <th>Comment</th>
            <th>Date</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% comments.forEach((comment) => { %>
            <tr>
              <td><%= comment.ad_title %></td>
              <td><%= comment.author %></td>
              <td>
                <%= comment.text %>
                <% if (comment.is_blocked) { %>
                  <span class="badge bg-danger ms-1">Blocked by admin</span>
                <% } %>
              </td>
              <td class="text-nowrap small text-muted"><%= comment.created_at.slice(0, 16) %></td>
              <td class="text-end">
                <form action="/admin/ads/comments/<%= comment.id %>/delete" method="POST" class="d-inline"
                      onsubmit="return confirm('Delete this comment?');">
                  <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>