<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <h1 class="h3 mb-4"><%= title %></h1>

    <% if (errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach((error) => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <form action="<%= isEdit ? '/admin/ads/' + ad.id : '/admin/ads' %>" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" class="form-control" id="title" name="title" value="<%= ad.title || '' %>" required minlength="3" maxlength="100">
          </div>

          <div class="row">
            <div class="col-md-6 mb-3">
              <label for="category_id" class="form-label">Category</label>
              <select class="form-select" id="category_id" name="category_id" required>
                <option value="">Choose...</option>
                <% categories.forEach((category) => { %>
                  <option value="<%= category.id %>" <%= Number(ad.category_id) === category.id ? 'selected' : '' %>><%= category.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label for="price" class="form-label">Price (€)</label>
              <input type="number" class="form-control" id="price" name="price" value="<%= ad.price ?? '' %>" required min="0" max="10000000" step="0.01">
            </div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea class="form-control" id="description" name="description" rows="5" required minlength="10" maxlength="2000"><%= ad.description || '' %></textarea>
          </div>

          <div class="mb-4">
            <label for="image" class="form-label">Image</label>
            <% if (isEdit && ad.image) { %>
              <div class="mb-2">
                <img src="/uploads/<%= ad.image %>" alt="" class="rounded" style="max-height: 150px;">
              </div>
            <% } %>
            <input type="file" class="form-control" id="image" name="image" accept="image/jpeg,image/png,image/webp,image/gif" <%= isEdit ? '' : 'required' %>>
            <div class="form-text">
              JPG, PNG, WEBP or GIF, up to 5 MB.<% if (isEdit) { %> Leave empty to keep the current image.<% } %>
            </div>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> <%= isEdit ? 'Save changes' : 'Publish' %></button>
            <a href="/admin/ads" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>