<%- include('../partials/header') %>

<h1 class="h3 mb-2"><i class="bi bi-star-fill text-warning"></i> Saved ads</h1>
<p class="text-muted mb-4">Ads you marked with a star on the public site.</p>

<% if (ads.length === 0) { %>
  <div class="alert alert-secondary">You have no saved ads yet.</div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Category</th>
            <th>Seller</th>
            <th class="text-end">Price</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% ads.forEach((ad) => { %>
            <tr>
              <td>
                <img src="/uploads/<%= ad.image %>" alt="" class="rounded" style="width: 64px; height: 48px; object-fit: cover;">
              </td>
              <td>
                <%= ad.title %>
                <% if (ad.is_blocked) { %>
                  <span class="badge bg-danger ms-1">Blocked</span>
                <% } %>
              </td>
              <td><%= ad.category_name %></td>
              <td><%= ad.author %></td>
              <td class="text-end text-nowrap"><%= ad.price.toFixed(2) %> €</td>
              <td class="text-end">
                <form action="/admin/ads/saved/<%= ad.id %>/delete" method="POST" class="d-inline">
                  <button class="btn btn-outline-secondary btn-sm"><i class="bi bi-star"></i> Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>