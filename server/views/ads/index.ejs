<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">My ads</h1>
  <a href="/admin/ads/new" class="btn btn-success"><i class="bi bi-plus-lg"></i> New ad</a>
</div>

<% if (ads.length === 0) { %>
  <div class="alert alert-secondary">You have no ads yet. Create your first one!</div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Image</th>
            <th>Title</th>
            <th>Category</th>
            <th class="text-end">Price</th>
            <th class="text-center">Comments</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% ads.forEach((ad) => { %>
            <tr>
              <td>
                <img src="/uploads/<%= ad.image %>" alt="" class="rounded" style="width: 64px; height: 48px; object-fit: cover;">
              </td>
              <td><%= ad.title %></td>
              <td><%= ad.category_name %></td>
              <td class="text-end text-nowrap"><%= ad.price.toFixed(2) %> €</td>
              <td class="text-center"><%= ad.comment_count %></td>
              <td>
                <% if (ad.is_blocked) { %>
                  <span class="badge bg-danger">Blocked</span>
                <% } else { %>
                  <span class="badge bg-success">Visible</span>
                <% } %>
              </td>
              <td class="text-end text-nowrap">
                <a href="/admin/ads/<%= ad.id %>/edit" class="btn btn-outline-primary btn-sm">
                  <i class="bi bi-pencil"></i> Edit
                </a>
                <form action="/admin/ads/<%= ad.id %>/delete" method="POST" class="d-inline"
                      onsubmit="return confirm('Delete this ad?');">
                  <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>