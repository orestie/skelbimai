<%- include('../partials/header') %>

<h1 class="h3 mb-2">All comments</h1>
<p class="text-muted mb-4">Blocked comments are hidden from the public site.</p>

<% if (comments.length === 0) { %>
  <div class="alert alert-secondary">There are no comments yet.</div>
<% } else { %>
  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Ad</th>
            <th>Author</th>
            <th>Comment</th>
            <th>Date</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% comments.forEach((comment) => { %>
            <tr>
              <td><%= comment.ad_title %></td>
              <td><%= comment.author %></td>
              <td><%= comment.text %></td>
              <td class="text-nowrap small text-muted"><%= comment.created_at.slice(0, 16) %></td>
              <td>
                <% if (comment.is_blocked) { %>
                  <span class="badge bg-danger">Blocked</span>
                <% } else { %>
                  <span class="badge bg-success">Visible</span>
                <% } %>
              </td>
              <td class="text-end">
                <form action="/admin/all-comments/<%= comment.id %>/toggle-block" method="POST" class="d-inline">
                  <% if (comment.is_blocked) { %>
                    <button class="btn btn-outline-success btn-sm"><i class="bi bi-unlock"></i> Unblock</button>
                  <% } else { %>
                    <button class="btn btn-outline-danger btn-sm"><i class="bi bi-lock"></i> Block</button>
                  <% } %>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>