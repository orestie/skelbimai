<%- include('../partials/header') %>

<h1 class="h3 mb-4">Categories</h1>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="h5 mb-3">Add category</h2>
        <form action="/admin/categories" method="POST">
          <div class="mb-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" id="name" name="name" required minlength="2" maxlength="50">
          </div>
          <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i> Add</button>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Name</th>
              <th class="text-center">Ads</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% categories.forEach((category) => { %>
              <tr>
                <td><%= category.name %></td>
                <td class="text-center"><%= category.adCount %></td>
                <td class="text-end">
                  <form action="/admin/categories/<%= category.id %>/delete" method="POST" class="d-inline"
                        onsubmit="return confirm('Delete this category?');">
                    <button class="btn btn-outline-danger btn-sm" <%= category.adCount > 0 ? 'disabled' : '' %>>
                      <i class="bi bi-trash"></i> Delete
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>